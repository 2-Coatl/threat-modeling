#!/usr/bin/env bash
# Enforce Conventional Commit format for commit messages.

set -euo pipefail

commit_msg_file="$1"

read -r first_line < "$commit_msg_file" || first_line=""

pattern='^(feat|fix|docs|style|refactor|test|chore|perf)(\([a-z0-9-]+\))?(!)?: .+'

if [[ -z "$first_line" ]]; then
    echo "[ERROR] Commit message is empty." >&2
    exit 1
fi

if [[ ! $first_line =~ $pattern ]]; then
    cat >&2 <<'MSG'
[ERROR] Commit message must follow Conventional Commits format:
  <type>(<scope>): <description>
Allowed types: feat, fix, docs, style, refactor, test, chore, perf
Example: fix(api): handle null response bodies
MSG
    exit 1
fi

exit 0
