#!/usr/bin/env bash
# infrastructure/bin/setup - Wrapper to bootstrap.sh
# Simple interface for users to run installation

set -euo pipefail

# ============================================================================
# CONSTANTS
# ============================================================================

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly INFRASTRUCTURE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
readonly PROJECT_ROOT="$(cd "${INFRASTRUCTURE_ROOT}/.." && pwd)"
readonly BOOTSTRAP_SCRIPT="${INFRASTRUCTURE_ROOT}/bootstrap.sh"

# ============================================================================
# GIT HOOKS SETUP
# ============================================================================

configure_git_hooks() {
    if ! command -v git >/dev/null 2>&1; then
        echo "[WARN] Git is not available; skipping hook configuration" >&2
        return 0
    fi

    if ! git -C "${PROJECT_ROOT}" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "[WARN] Not inside a Git repository; skipping hook configuration" >&2
        return 0
    fi

    local current_path
    current_path=$(git -C "${PROJECT_ROOT}" config --get core.hooksPath || true)

    if [[ "${current_path}" == ".githooks" ]]; then
        echo "[INFO] Git hooks path already configured" >&2
        return 0
    fi

    if git -C "${PROJECT_ROOT}" config core.hooksPath .githooks; then
        echo "[INFO] Configured Git hooks path to .githooks" >&2
    else
        echo "[ERROR] Failed to configure Git hooks path" >&2
        return 1
    fi

    return 0
}

configure_git_hooks || exit 1

# ============================================================================
# VALIDATION
# ============================================================================

if [[ ! -f "${BOOTSTRAP_SCRIPT}" ]]; then
    echo "ERROR: bootstrap.sh not found at: ${BOOTSTRAP_SCRIPT}" >&2
    exit 1
fi

if [[ ! -r "${BOOTSTRAP_SCRIPT}" ]]; then
    echo "ERROR: bootstrap.sh is not readable" >&2
    exit 1
fi

# ============================================================================
# ROOT CHECK WARNING
# ============================================================================

if [[ ${EUID} -ne 0 ]]; then
    echo "WARNING: This script should be run as root (use sudo)" >&2
    echo "Attempting to run bootstrap with sudo..." >&2
    echo "" >&2

    exec sudo bash "${BOOTSTRAP_SCRIPT}" "$@"
else
    exec bash "${BOOTSTRAP_SCRIPT}" "$@"
fi