{
  "name": "threat-modeling-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Modular monolith front-end for the threat modeling platform.",
  "scripts": {
    "start": "webpack serve --config webpack.config.cjs --env development",
    "build": "webpack --config webpack.config.cjs --env production",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.5.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "style-loader": "^3.3.4",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
    "moduleNameMapper": {
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@styles/(.*)$": "<rootDir>/src/styles/$1",
      "^@state/(.*)$": "<rootDir>/src/state/$1",
      "\\.(css)$": "identity-obj-proxy"
    },
    "transform": {
      "^.+\\.[tj]sx?$": "babel-jest"
    }
  }
}
