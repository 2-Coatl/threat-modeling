<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tomcat Context Configuration for Threat Model Outputs

  Purpose: Serve static files from /vagrant/dashboard/output via Tomcat
  Path:    /opt/tomcat/conf/Catalina/localhost/outputs.xml
  Access:  http://localhost:8080/outputs/

  Features:
    - Directory listing enabled
    - Read-only access
    - No session management (static files only)
    - Anti-resource locking disabled (for shared folders)

  Installation:
    Copy to: /opt/tomcat/conf/Catalina/localhost/outputs.xml
    Owner:   tomcat:tomcat
    Perms:   644
-->
<Context
    path="/outputs"
    docBase="/vagrant/dashboard/output"
    reloadable="false"
    privileged="false"
    antiResourceLocking="false">

    <!-- Disable session persistence for static content -->
    <Manager pathname="" />

    <!-- Enable directory browsing -->
    <Parameter name="listings" value="true" override="false"/>

    <!-- Read-only access to files -->
    <Parameter name="readonly" value="true" override="false"/>

    <!-- Security: Allow access from any IP (localhost + host machine) -->
    <Valve className="org.apache.catalina.valves.RemoteAddrValve"
           allow=".*" />

</Context>